{
  "openapi": "3.0.3",
  "info": {
    "title": "EU E-Invoice API: Factur-X / ZUGFeRD generator & EN 16931 validator",
    "version": "1.0.0",
    "description": "Create and validate EU e-invoices with one call.\n\n* **POST /v1/invoices**: send simple JSON, get a Factur-X / ZUGFeRD PDF (PDF/A-3 with embedded EN 16931 XML). Totals and VAT are calculated for you. Output passes veraPDF and Mustang.\n* **POST /v1/validate**: send UBL/CII XML or a Factur-X/ZUGFeRD PDF; get errors with rule IDs and plain-English hints.\n\nInvoice contents are processed in memory and never stored. Technical format generation and validation only; not tax or legal advice."
  },
  "servers": [
    {
      "url": "https://api.yourdomain.com",
      "description": "Replace with your deployed base URL"
    }
  ],
  "tags": [
    {
      "name": "Invoices"
    },
    {
      "name": "Validation"
    }
  ],
  "paths": {
    "/v1/invoices": {
      "post": {
        "tags": [
          "Invoices"
        ],
        "operationId": "createInvoice",
        "summary": "Create a Factur-X / ZUGFeRD e-invoice",
        "description": "Returns a PDF by default. Use format=xml for the CII XML only, or format=json for totals, XML and the PDF (base64).",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pdf",
                "xml",
                "json"
              ],
              "default": "pdf"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Invoice"
              },
              "example": {
                "invoice": {
                  "number": "FA-2026-0042",
                  "type": "invoice",
                  "issue_date": "2026-11-01",
                  "due_date": "2026-12-01",
                  "currency": "EUR",
                  "buyer_reference": "PO-7781",
                  "note": "Fictional test invoice (SIREN/VAT numbers are synthetic). Not a real transaction.",
                  "delivery_date": "2026-10-31",
                  "notes": [
                    {
                      "subject": "PMD",
                      "text": "En cas de retard de paiement, pénalités au taux égal à 3 fois le taux d'intérêt légal."
                    },
                    {
                      "subject": "PMT",
                      "text": "Indemnité forfaitaire pour frais de recouvrement : 40 EUR."
                    },
                    {
                      "subject": "AAB",
                      "text": "Pas d'escompte pour paiement anticipé."
                    }
                  ]
                },
                "seller": {
                  "name": "Atelier Exemple SARL",
                  "vat_id": "FR88100000009",
                  "address": {
                    "line1": "12 rue de l'Exemple",
                    "postcode": "75011",
                    "city": "Paris",
                    "country": "FR"
                  },
                  "legal_id": {
                    "scheme": "0002",
                    "id": "100000009"
                  },
                  "electronic_address": {
                    "scheme": "0225",
                    "id": "100000009"
                  }
                },
                "buyer": {
                  "name": "Client Démo SAS",
                  "vat_id": "FR68900000001",
                  "address": {
                    "line1": "5 avenue du Test",
                    "postcode": "69002",
                    "city": "Lyon",
                    "country": "FR"
                  },
                  "legal_id": {
                    "scheme": "0002",
                    "id": "900000001"
                  },
                  "electronic_address": {
                    "scheme": "0225",
                    "id": "900000001"
                  }
                },
                "payment": {
                  "means": "sepa_credit_transfer",
                  "iban": "FR76 3000 6000 0112 3456 7890 189",
                  "bic": "AGRIFRPP",
                  "reference": "FA-2026-0042",
                  "terms": "Payment within 30 days. No discount for early payment."
                },
                "lines": [
                  {
                    "description": "Web development (hours)",
                    "quantity": "12.5",
                    "unit": "HUR",
                    "unit_price": "85.00",
                    "vat_rate": "20"
                  },
                  {
                    "description": "Hosting setup (one-off)",
                    "quantity": "1",
                    "unit": "C62",
                    "unit_price": "149.99",
                    "vat_rate": "20"
                  },
                  {
                    "description": "Domain name, 1 year",
                    "quantity": "3",
                    "unit": "C62",
                    "unit_price": "11.333",
                    "vat_rate": "20"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The e-invoice",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceResult"
                }
              }
            }
          },
          "400": {
            "description": "Invoice data incomplete or wrong (message names the field)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit or quota reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/validate": {
      "post": {
        "tags": [
          "Validation"
        ],
        "operationId": "validateInvoice",
        "summary": "Validate an e-invoice (UBL/CII XML or Factur-X/ZUGFeRD PDF)",
        "description": "Send the raw file as the body. HTTP 200 whenever the document was processed: check `valid`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/xml": {
              "schema": {
                "type": "string"
              }
            },
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationReport"
                }
              }
            }
          },
          "413": {
            "description": "File larger than 10 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Not XML or PDF",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "PDF without embedded e-invoice XML",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Invoice": {
        "type": "object",
        "required": [
          "invoice",
          "seller",
          "buyer",
          "lines"
        ],
        "description": "Invoice data. Do NOT send totals: line totals, VAT per rate and the amount due are calculated for you.",
        "properties": {
          "invoice": {
            "type": "object",
            "required": [
              "number",
              "issue_date",
              "delivery_date"
            ],
            "properties": {
              "number": {
                "type": "string",
                "example": "FA-2026-0042"
              },
              "type": {
                "type": "string",
                "enum": [
                  "invoice",
                  "credit_note"
                ],
                "default": "invoice"
              },
              "issue_date": {
                "type": "string",
                "format": "date",
                "example": "2026-11-01"
              },
              "delivery_date": {
                "type": "string",
                "format": "date",
                "description": "Date of delivery or service (legally required in DE/FR)"
              },
              "due_date": {
                "type": "string",
                "format": "date",
                "description": "Give due_date or payment.terms"
              },
              "currency": {
                "type": "string",
                "default": "EUR",
                "example": "EUR"
              },
              "buyer_reference": {
                "type": "string",
                "example": "PO-7781"
              },
              "note": {
                "type": "string"
              },
              "notes": {
                "type": "array",
                "description": "Coded notes. France requires PMD, PMT and AAB.",
                "items": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "subject": {
                      "type": "string",
                      "description": "UNTDID 4451 code, e.g. PMD, PMT, AAB",
                      "example": "PMT"
                    },
                    "text": {
                      "type": "string",
                      "example": "Indemnité forfaitaire pour frais de recouvrement : 40 EUR."
                    }
                  }
                }
              }
            }
          },
          "seller": {
            "type": "object",
            "required": [
              "name",
              "address"
            ],
            "properties": {
              "name": {
                "type": "string",
                "example": "Atelier Exemple SARL"
              },
              "vat_id": {
                "type": "string",
                "description": "Seller VAT identifier (required)",
                "example": "FR88100000009"
              },
              "address": {
                "type": "object",
                "required": [
                  "country"
                ],
                "properties": {
                  "line1": {
                    "type": "string",
                    "example": "12 rue de l'Exemple"
                  },
                  "line2": {
                    "type": "string"
                  },
                  "postcode": {
                    "type": "string",
                    "example": "75011"
                  },
                  "city": {
                    "type": "string",
                    "example": "Paris"
                  },
                  "country": {
                    "type": "string",
                    "description": "ISO 3166-1 alpha-2 country code",
                    "pattern": "^[A-Za-z]{2}$",
                    "example": "FR"
                  }
                }
              },
              "legal_id": {
                "type": "object",
                "required": [
                  "scheme",
                  "id"
                ],
                "properties": {
                  "scheme": {
                    "type": "string",
                    "description": "Identifier scheme (ISO 6523 ICD / EAS code)",
                    "example": "0002"
                  },
                  "id": {
                    "type": "string",
                    "example": "100000009"
                  }
                },
                "description": "Legal registration ID, e.g. French SIREN with scheme 0002 (required in France)"
              },
              "electronic_address": {
                "type": "object",
                "required": [
                  "scheme",
                  "id"
                ],
                "properties": {
                  "scheme": {
                    "type": "string",
                    "description": "Identifier scheme (ISO 6523 ICD / EAS code)",
                    "example": "0002"
                  },
                  "id": {
                    "type": "string",
                    "example": "100000009"
                  }
                },
                "description": "Where e-invoices are delivered (required in France)"
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "Used as electronic address if electronic_address is not given"
              }
            }
          },
          "buyer": {
            "type": "object",
            "required": [
              "name",
              "address"
            ],
            "properties": {
              "name": {
                "type": "string",
                "example": "Atelier Exemple SARL"
              },
              "vat_id": {
                "type": "string",
                "description": "Buyer VAT identifier",
                "example": "FR88100000009"
              },
              "address": {
                "type": "object",
                "required": [
                  "country"
                ],
                "properties": {
                  "line1": {
                    "type": "string",
                    "example": "12 rue de l'Exemple"
                  },
                  "line2": {
                    "type": "string"
                  },
                  "postcode": {
                    "type": "string",
                    "example": "75011"
                  },
                  "city": {
                    "type": "string",
                    "example": "Paris"
                  },
                  "country": {
                    "type": "string",
                    "description": "ISO 3166-1 alpha-2 country code",
                    "pattern": "^[A-Za-z]{2}$",
                    "example": "FR"
                  }
                }
              },
              "legal_id": {
                "type": "object",
                "required": [
                  "scheme",
                  "id"
                ],
                "properties": {
                  "scheme": {
                    "type": "string",
                    "description": "Identifier scheme (ISO 6523 ICD / EAS code)",
                    "example": "0002"
                  },
                  "id": {
                    "type": "string",
                    "example": "100000009"
                  }
                },
                "description": "Legal registration ID, e.g. French SIREN with scheme 0002 (required in France)"
              },
              "electronic_address": {
                "type": "object",
                "required": [
                  "scheme",
                  "id"
                ],
                "properties": {
                  "scheme": {
                    "type": "string",
                    "description": "Identifier scheme (ISO 6523 ICD / EAS code)",
                    "example": "0002"
                  },
                  "id": {
                    "type": "string",
                    "example": "100000009"
                  }
                },
                "description": "Where e-invoices are delivered (required in France)"
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "Used as electronic address if electronic_address is not given"
              }
            }
          },
          "payment": {
            "type": "object",
            "properties": {
              "means": {
                "type": "string",
                "enum": [
                  "credit_transfer",
                  "sepa_credit_transfer",
                  "bank_transfer",
                  "direct_debit",
                  "card",
                  "not_defined"
                ],
                "default": "credit_transfer"
              },
              "iban": {
                "type": "string",
                "example": "FR7630006000011234567890189"
              },
              "bic": {
                "type": "string",
                "example": "AGRIFRPP"
              },
              "reference": {
                "type": "string"
              },
              "terms": {
                "type": "string",
                "example": "Payment within 30 days."
              }
            }
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "description",
                "quantity",
                "unit_price",
                "vat_rate"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "example": "Web development (hours)"
                },
                "quantity": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$",
                  "description": "Quantity",
                  "example": "12.5"
                },
                "unit": {
                  "type": "string",
                  "default": "C62",
                  "description": "UN/ECE Rec. 20 unit code: C62 piece, HUR hour, DAY day"
                },
                "unit_price": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$",
                  "description": "Net price per unit (not negative)",
                  "example": "85.00"
                },
                "vat_rate": {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$",
                  "description": "VAT rate in percent (standard-rated VAT)",
                  "example": "20"
                }
              }
            }
          }
        },
        "example": {
          "invoice": {
            "number": "FA-2026-0042",
            "type": "invoice",
            "issue_date": "2026-11-01",
            "due_date": "2026-12-01",
            "currency": "EUR",
            "buyer_reference": "PO-7781",
            "note": "Fictional test invoice (SIREN/VAT numbers are synthetic). Not a real transaction.",
            "delivery_date": "2026-10-31",
            "notes": [
              {
                "subject": "PMD",
                "text": "En cas de retard de paiement, pénalités au taux égal à 3 fois le taux d'intérêt légal."
              },
              {
                "subject": "PMT",
                "text": "Indemnité forfaitaire pour frais de recouvrement : 40 EUR."
              },
              {
                "subject": "AAB",
                "text": "Pas d'escompte pour paiement anticipé."
              }
            ]
          },
          "seller": {
            "name": "Atelier Exemple SARL",
            "vat_id": "FR88100000009",
            "address": {
              "line1": "12 rue de l'Exemple",
              "postcode": "75011",
              "city": "Paris",
              "country": "FR"
            },
            "legal_id": {
              "scheme": "0002",
              "id": "100000009"
            },
            "electronic_address": {
              "scheme": "0225",
              "id": "100000009"
            }
          },
          "buyer": {
            "name": "Client Démo SAS",
            "vat_id": "FR68900000001",
            "address": {
              "line1": "5 avenue du Test",
              "postcode": "69002",
              "city": "Lyon",
              "country": "FR"
            },
            "legal_id": {
              "scheme": "0002",
              "id": "900000001"
            },
            "electronic_address": {
              "scheme": "0225",
              "id": "900000001"
            }
          },
          "payment": {
            "means": "sepa_credit_transfer",
            "iban": "FR76 3000 6000 0112 3456 7890 189",
            "bic": "AGRIFRPP",
            "reference": "FA-2026-0042",
            "terms": "Payment within 30 days. No discount for early payment."
          },
          "lines": [
            {
              "description": "Web development (hours)",
              "quantity": "12.5",
              "unit": "HUR",
              "unit_price": "85.00",
              "vat_rate": "20"
            },
            {
              "description": "Hosting setup (one-off)",
              "quantity": "1",
              "unit": "C62",
              "unit_price": "149.99",
              "vat_rate": "20"
            },
            {
              "description": "Domain name, 1 year",
              "quantity": "3",
              "unit": "C62",
              "unit_price": "11.333",
              "vat_rate": "20"
            }
          ]
        }
      },
      "InvoiceResult": {
        "type": "object",
        "properties": {
          "invoice_number": {
            "type": "string"
          },
          "profile": {
            "type": "string",
            "example": "factur-x-en16931"
          },
          "currency": {
            "type": "string",
            "example": "EUR"
          },
          "totals": {
            "type": "object",
            "properties": {
              "net": {
                "type": "string",
                "example": "1246.49"
              },
              "vat": {
                "type": "string",
                "example": "249.30"
              },
              "gross": {
                "type": "string",
                "example": "1495.79"
              },
              "due": {
                "type": "string",
                "example": "1495.79"
              }
            }
          },
          "vat_breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rate": {
                  "type": "string",
                  "example": "20"
                },
                "taxable": {
                  "type": "string",
                  "example": "1246.49"
                },
                "vat": {
                  "type": "string",
                  "example": "249.30"
                }
              }
            }
          },
          "xml": {
            "type": "string",
            "description": "CII XML"
          },
          "pdf_base64": {
            "type": "string",
            "format": "byte"
          }
        }
      },
      "ValidationReport": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "xml",
              "pdf"
            ]
          },
          "format": {
            "type": "string",
            "nullable": true,
            "example": "EN16931 core (CII)"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning",
                    "information"
                  ]
                },
                "rule": {
                  "type": "string",
                  "nullable": true,
                  "example": "BR-CO-16"
                },
                "message": {
                  "type": "string"
                },
                "location": {
                  "type": "string",
                  "nullable": true
                },
                "hint": {
                  "type": "string",
                  "description": "Plain-English explanation (common rules)"
                }
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning",
                    "information"
                  ]
                },
                "rule": {
                  "type": "string",
                  "nullable": true,
                  "example": "BR-CO-16"
                },
                "message": {
                  "type": "string"
                },
                "location": {
                  "type": "string",
                  "nullable": true
                },
                "hint": {
                  "type": "string",
                  "description": "Plain-English explanation (common rules)"
                }
              }
            }
          },
          "information": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "type": "string",
                  "enum": [
                    "error",
                    "warning",
                    "information"
                  ]
                },
                "rule": {
                  "type": "string",
                  "nullable": true,
                  "example": "BR-CO-16"
                },
                "message": {
                  "type": "string"
                },
                "location": {
                  "type": "string",
                  "nullable": true
                },
                "hint": {
                  "type": "string",
                  "description": "Plain-English explanation (common rules)"
                }
              }
            }
          },
          "ruleset": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "invalid_invoice"
              },
              "message": {
                "type": "string",
                "example": "invoice.delivery_date is required"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
