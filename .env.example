# Copy to .env and fill in. .env is ignored by git: never commit real secrets.

# Database password: use a long random value, e.g. from:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Shown on the website
PRODUCT_NAME=InvoiceFormat API
CONTACT_EMAIL=

# Public address of your API (used in docs and examples)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Allow anyone to create a free API key on the website (true/false)
SIGNUP_ENABLED=true

# Maximum upload size in bytes (10 MB)
MAX_BODY_BYTES=10485760

# RapidAPI marketplace: paste the "X-RapidAPI-Proxy-Secret" value from your RapidAPI
# provider dashboard. Leave empty to switch the RapidAPI integration off.
RAPIDAPI_PROXY_SECRET=

# Optional checkout links from your payment provider (direct sales on your own website)
PAYMENT_LINK_STARTER=
PAYMENT_LINK_GROWTH=
PAYMENT_LINK_SCALE=

# Local port for the API (local development only)
API_PORT=8000

# --- Production only (deploy/docker-compose.prod.yml) ---
# Your domain, pointed at the server's IP address (DNS A record)
DOMAIN=api.example.com
